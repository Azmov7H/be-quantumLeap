# be-quantumLeap — environment example
# Copy to `.env` and fill in real values. NEVER commit a real `.env` file.
# Placeholders only — no secrets belong in this file.

# --- Server ---
# HTTP port. Defaults to 7000 when unset (see server.js).
PORT=7000

# development | production | test
# Used by utils/responseHelper.js and middlewares/errorHandler.js to decide
# whether error stacks are included in responses.
NODE_ENV=development

# --- Database ---
# Required by config/db.js. Standalone or replica-set connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/quantumleap

# --- Authentication ---
# Required by services/authService.js and middlewares/auth.js.
# Use a long random string, e.g. `openssl rand -hex 64`.
JWT_SECRET=replace-with-a-long-random-secret

# --- CORS / Socket.IO ---
# Required by server.js (CORS) and socket.js (Socket.IO origin).
# Must match the frontend origin, e.g. http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Cloudinary (media uploads) ---
# Required by config/cloudinary.js. Uploads fail without these.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
